# ===== Server Minecraft =====
HOST=play.relxmc.com
PORT=25565
VERSION=1.20.1

# ===== Akun bot (tambah BOT4_..., dst. kalau perlu) =====
# TARGET_X / TARGET_Z = koordinat titik farm untuk !farm (0 = belum diatur, bisa juga lewat !setfarm)
BOT1_USERNAME=isi_username_1
BOT1_PASSWORD=isi_password_1
BOT1_TARGET_X=0
BOT1_TARGET_Z=0

BOT2_USERNAME=isi_username_2
BOT2_PASSWORD=isi_password_2
BOT2_TARGET_X=0
BOT2_TARGET_Z=0

BOT3_USERNAME=isi_username_3
BOT3_PASSWORD=isi_password_3
BOT3_TARGET_X=0
BOT3_TARGET_Z=0

# ===== Discord =====
# Token dari Discord Developer Portal -> Bot -> Reset Token (JANGAN dibagikan ke siapa pun)
DISCORD_TOKEN=
# ID server Discord. Kosong = ketik "server create" di console agar bot membuat server baru,
# atau undang bot ke server kosong lalu isi ID-nya (klik kanan server -> Copy Server ID)
DISCORD_GUILD_ID=

# --- Diisi OTOMATIS oleh bot setelah server dibangun (jangan diubah kecuali perlu) ---
DISCORD_LOG_CHANNEL_ID=
DISCORD_CMD_CHANNEL_ID=
DISCORD_LIVE_CHANNEL_ID=
DISCORD_OPERATOR_ROLE_ID=
DISCORD_VIEWER_ROLE_ID=

# Opsional: ID pengguna yang selalu boleh memakai command (pisahkan dengan koma), di luar role Operator
DISCORD_ALLOWED_USER_IDS=
# Live status otomatis di channel live (detik, minimal 5). 0 = mati. Diisi 10 oleh setup kalau masih kosong.
LIVE_AUTO_SECONDS=

# ===== Opsional =====
RECONNECT_DELAY=90000
JUMP_MIN_MINUTES=2
JUMP_MAX_MINUTES=4
REJOIN_RETRY_DELAY=10000
REJOIN_MAX_ATTEMPTS=40
# true = setelah masuk ecocpvp & /afk, bot otomatis jalan ke titik farm (BOTn_TARGET_X/Z atau !setfarm)
AUTO_FARM=false
